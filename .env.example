# ============ RAG-Forge 配置示例 ============
# 复制本文件为 .env 后按需修改

# --- 向量库: qdrant_local | qdrant_server | in_memory；qdrant 是 server 别名 ---
RAG_VECTOR_STORE=qdrant_local
RAG_QDRANT_PATH=data/qdrant
RAG_QDRANT_COLLECTION=rag_forge_local_v1
RAG_INDEX_MANIFEST_PATH=data/index_manifest.json

# --- 嵌入: ollama(bge-m3) | local(sentence-transformers) | api | deterministic ---
RAG_EMBEDDER_BACKEND=ollama
RAG_EMBEDDER_MODEL=bge-m3
RAG_EMBEDDER_DIM=1024
RAG_EMBEDDER_BATCH_SIZE=16
# 可选 provider revision/digest；同名模型更新后必须修改并重新索引
RAG_EMBEDDER_DIGEST=

# --- 生成后端: ollama | api | offline ---
RAG_GENERATION_BACKEND=ollama
RAG_OLLAMA_BASE_URL=http://127.0.0.1:11434
# Docker Desktop override: the container must reach host Ollama through host.docker.internal
RAG_OLLAMA_DOCKER_BASE_URL=http://host.docker.internal:11434
RAG_DEFAULT_GENERATION_MODEL=gemma3:4b
RAG_ALLOWED_GENERATION_MODELS=["gemma3:4b","gemma4:e4b"]
RAG_OLLAMA_CONNECT_TIMEOUT=5
RAG_OLLAMA_GENERATE_TIMEOUT=180
# 可选；评测 profile 应显式设置并记录这些生成参数
# RAG_GENERATION_TEMPERATURE=0.2
# RAG_GENERATION_NUM_PREDICT=512
# RAG_GENERATION_SEED=42

# --- 旧云端生成（仅 generation_backend=api 时使用） ---
RAG_LLM_BASE_URL=https://api.deepseek.com/v1
RAG_LLM_API_KEY=replace-with-your-key
RAG_LLM_MODEL=deepseek-chat

# --- API 保护（配置后所有 API 请求需带 X-API-Key；本地开发可留空） ---
RAG_API_KEY=
RAG_RATE_LIMIT_PER_MINUTE=60

# --- 远程 Qdrant 认证（本地 Compose 可留空） ---
RAG_QDRANT_API_KEY=

# --- 检索 ---
RAG_RETRIEVAL_MODE=hybrid
RAG_DENSE_TOP_K=20
RAG_TOP_K=5
RAG_SPARSE_TOP_K=20
RAG_RERANK_CANDIDATE_K=40
RAG_RERANK_TOP_K=5
RAG_RERANK_MODEL=BAAI/bge-reranker-base
RAG_USE_RERANK=false
RAG_CHUNK_STRATEGY=heading_chars
RAG_CHUNK_SIZE=2200
RAG_CHUNK_OVERLAP=200
RAG_REFUSE_THRESHOLD=0.15
RAG_CONTEXT_MAX_CHARS=12000
RAG_TRACE_MAX_ENTRIES=100
RAG_TRACE_TTL_SECONDS=3600
RAG_TRACE_MAX_ITEM_CHARS=4000
RAG_REWRITE_ENABLED=false
RAG_REWRITE_MODEL=qwen3:0.6b
RAG_REWRITE_MAX_CHARS=1000
RAG_REWRITE_HISTORY_MAX_MESSAGES=20

# --- API 摄入安全边界（请求 paths 必须位于此目录内） ---
RAG_INGEST_ROOT=data/raw/docs
RAG_MAX_INGEST_BYTES=10485760
RAG_INGEST_TOTAL_BYTES=33554432
RAG_MAX_REQUEST_BODY_BYTES=131072
RAG_ALLOWED_HOSTS=["127.0.0.1","localhost"]
