# ============ RAG-Forge 配置示例 ============
# 复制本文件为 .env 后按需修改

# --- 向量库: qdrant | in_memory | pgvector ---
RAG_VECTOR_STORE=in_memory

# --- 嵌入: local(bge,需装[local]) | api(OpenAI兼容) ---
RAG_EMBEDDER_BACKEND=local
RAG_EMBEDDER_MODEL=BAAI/bge-m3
RAG_EMBEDDER_DIM=1024

# --- 生成 LLM(OpenAI 兼容,如 DeepSeek/Qwen/本地 vLLM) ---
RAG_LLM_BASE_URL=https://api.deepseek.com/v1
RAG_LLM_API_KEY=sk-your-key
RAG_LLM_MODEL=deepseek-chat

# --- 检索 ---
RAG_TOP_K=4
RAG_RERANK_TOP_K=4
RAG_RERANK_MODEL=BAAI/bge-reranker-base
RAG_USE_RERANK=true
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=100